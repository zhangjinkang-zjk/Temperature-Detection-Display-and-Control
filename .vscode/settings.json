{
    "cmake.cmakePath": "cube-cmake",
    "cmake.configureArgs": [
        "-DCMAKE_COMMAND=cube-cmake",
        // 注意：工作区的 configureArgs 会把用户级 settings.json 里的同名项**整个覆盖**，
        // 所以上面那条 hex/bin 生成钩子必须在这里重复一遍，否则构建不再产出 .hex/.bin
        "-DCMAKE_PROJECT_TOP_LEVEL_INCLUDES=F:/stm32/stm32_shared.cmake"
    ],
    "cmake.preferredGenerators": [
        "Ninja"
    ]
}
